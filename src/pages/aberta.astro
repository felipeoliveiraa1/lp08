---
import Base from '../layouts/Base.astro';
// Versão "aberta" — TESTE A/B de VSL (vturb ab-test 6a9af868…) — variantes 6a99ef0b e 6a9af897.
// VSL + botão que só aparece após 16:09 de vídeo (tempo do pitch informado).
const CHECKOUT = 'https://checkout.payt.com.br/5ecd76cef086597a75e716faf73aa445?split=12';
---
<Base>
  <!-- gate: esconde o botão até o play completar 16:09. Roda antes da pintura (sem flash).
       Sem JS / com ?preview, nada é escondido. -->
  <script is:inline>try{if(!localStorage.getItem('al_aberta_revealed_v2')&&!/[?&]preview/.test(location.search))document.documentElement.classList.add('gated')}catch(e){document.documentElement.classList.add('gated')}</script>

  <!-- ============ HERO (aberta) ============ -->
  <header class="hero" style="background-image:url(/assets/hero-bg.webp)">
    <div class="wrap--narrow">
      <h1 class="hero-title">
        Trabalhadores brasileiros estão <span class="green">saindo da CLT</span> com essa nova inteligência artificial.
      </h1>
      <p class="hero-sub">Assista ao vídeo abaixo e veja como fazer um <strong>segundo salário em dólar</strong> ainda essa semana</p>
      <!-- ===== VSL — player nativo do TESTE A/B do vturb (carrega no load = play-rate real) ===== -->
      <div class="vsl-slot" id="vsl">
        <img class="vsl-poster" src="/assets/vsl-cover-nova.webp" alt="" fetchpriority="high" decoding="async" width="460" height="818" />
        <vturb-smartplayer id="ab-6a9af868d58be9f0e09a4997" style="display:block;width:100%;height:100%"></vturb-smartplayer>
      </div>
      <script is:inline>
        /* adia o player p/ logo após o 1º paint (fora da janela do LCP): no máx 2s (requestIdleCallback)
           ou na 1ª interação. Ainda carrega p/ todos que ficam >~1s = play-rate real preservado. */
        (function(){var SRC='https://scripts.converteai.net/d9544c5d-ba21-4c7b-aa65-b6663bf5494d/ab-test/6a9af868d58be9f0e09a4997/player.js',done=false;function load(){if(done)return;done=true;var s=document.createElement('script');s.src=SRC;s.async=true;document.head.appendChild(s);}if('requestIdleCallback' in window){requestIdleCallback(load,{timeout:2000});}else{setTimeout(load,1500);}['pointerdown','touchstart','scroll','keydown'].forEach(function(e){addEventListener(e,load,{once:true,passive:true});});})();
      </script>

      <div class="gate" id="hero-cta">
        <p class="cupom mt-m">CUPOM LIBERADO</p>
        <div class="cta-wrap"><a class="btn" href={CHECKOUT}>QUERO TER ACESSO AGORA</a></div>
      </div>
    </div>
  </header>

  <!-- reveal: botão aparece quando o VÍDEO chega em 16:09 (currentTime real do player
       vturb). ?preview revela na hora (QA). Persiste. Fail-open se o player não carregar. -->
  <script is:inline>
    (function () {
      var PITCH = 16 * 60 + 9; // 16:09 = 969s de vídeo
      var KEY = 'al_aberta_revealed_v2', iv = null, t0 = Date.now(), saw = false;
      function reveal() {
        document.documentElement.classList.remove('gated');
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
        if (iv) { clearInterval(iv); iv = null; }
      }
      function vtime() { try { var a = (window.smartplayer && window.smartplayer.instances) || []; for (var i = 0; i < a.length; i++) { var t = a[i] && a[i].instance && a[i].instance.currentTime; if (typeof t === 'number' && isFinite(t)) return t; } } catch (e) {} return -1; }
      function check() { var t = vtime(); if (t >= 0) saw = true; if (t >= PITCH) return reveal(); if (!saw && Date.now() - t0 > 30000) reveal(); }
      try { if (/[?&]preview/.test(location.search)) { document.documentElement.classList.remove('gated'); return; } } catch (e) {}
      try { if (localStorage.getItem(KEY)) { reveal(); return; } } catch (e) {}
      iv = setInterval(check, 1000);
    })();
  </script>

  <footer class="foot">
    <p>Operar mercados alavancados envolve risco real de perda.</p>
    <p style="margin-top:8px">MATCHUP TREINAMENTOS LTDA - ME - CNPJ 43.108.423/0001-32</p>
  </footer>
</Base>
