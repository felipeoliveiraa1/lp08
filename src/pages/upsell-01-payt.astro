---
import Funnel from '../layouts/Funnel.astro';
import Vsl from '../components/Vsl.astro';
---
<Funnel title="UPSELL 01 PAYT – A Sociedade Trader" poster="/assets/poster-upsell-01.webp">
  <!-- gate: esconde os botões até 4:14 após o play. Roda antes da pintura (sem flash);
       sem JS, nada é escondido (fallback). -->
  <script is:inline>try{if(!localStorage.getItem('al_up01_revealed_v2')&&!/[?&]preview/.test(location.search))document.documentElement.classList.add('gated')}catch(e){document.documentElement.classList.add('gated')}</script>
  <div class="scarcity">⚠️ IMPORTANTE: ESSA PÁGINA SAIRÁ DO AR EM <span id="cd">15:00</span></div>
  <main class="funnel">
    <div class="funnel-wrap">
      <h1 class="funnel-title">Sua compra ainda<br />não está completa…</h1>
      <ul class="steps-card">
        <li><span class="ic">✅</span> Passo 1: Sociedade do Trader</li>
        <li class="is-now"><span class="ic">⚙️</span> Passo 2: Configuração blindada</li>
        <li><span class="ic">⏳</span> Passo 3: Compra concluída!</li>
      </ul>
      <Vsl playerId="vid-6aa9c80772cd6c56ec7bcc68" />
      <div class="gate" id="up01-cta">
        <div data-mndpay-render="01a0d3e0-0c76-719f-ba62-d84f177e1b63"></div>
      </div>
    </div>
  </main>
  <!-- reveal: CTA aparece quando o VÍDEO chega em 4:10 (currentTime real do player vturb).
       ?preview revela na hora (QA). Persiste. Fail-open se o player não carregar (adblock). -->
  <script is:inline>
    (function () {
      // VSL NOVA (vid-6aa9c807, 5:24, turbo 1.2x): tempo herdado do vídeo antigo,
      // A CONFIRMAR com o Matheus (ler na linha do tempo do player, não no cronômetro).
      var PITCH = 4 * 60 + 10; // 4:10 = 250s de vídeo
      var KEY = 'al_up01_revealed_v2', iv = null, t0 = Date.now(), saw = false;
      function reveal() { document.documentElement.classList.remove('gated'); try { localStorage.setItem(KEY, '1'); } catch (e) {} if (iv) { clearInterval(iv); iv = null; } }
      function vtime() { try { var a = (window.smartplayer && window.smartplayer.instances) || []; for (var i = 0; i < a.length; i++) { var t = a[i] && a[i].instance && a[i].instance.currentTime; if (typeof t === 'number' && isFinite(t)) return t; } } catch (e) {} return -1; }
      function check() { var t = vtime(); if (t >= 0) saw = true; if (t >= PITCH) return reveal(); if (!saw && Date.now() - t0 > 30000) reveal(); }
      try { if (/[?&]preview/.test(location.search)) { document.documentElement.classList.remove('gated'); return; } } catch (e) {}
      try { if (localStorage.getItem(KEY)) { reveal(); return; } } catch (e) {}
      iv = setInterval(check, 1000);
    })();
  </script>
</Funnel>
