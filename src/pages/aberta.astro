---
import Base from '../layouts/Base.astro';
// TESTE A/B de VSL (vturb ab-test 6a9b1c04…), 50/50:
//   NOVA   6a9b1c22de8d4ffcb0692883 -> pitch 19:15 de video (~16:03 no relogio; player roda em turbo 1.2x)
//   ANTIGA 6a9b1c1bd50c330afd8ddce0 -> pitch 18:03
// O gate detecta qual variante o A/B sorteou e usa o tempo certo de cada uma.
const CHECKOUT = 'https://checkout.payt.com.br/5ecd76cef086597a75e716faf73aa445?split=12';
---
<Base>
  <!-- gate: esconde o botão até o vídeo chegar no pitch da variante (19:15 nova / 18:03 antiga, na linha do tempo do video).
       Roda antes da pintura (sem flash). Sem JS / com ?preview, nada é escondido. -->
  <script is:inline>try{if(!localStorage.getItem('al_aberta_revealed_v2')&&!/[?&]preview/.test(location.search))document.documentElement.classList.add('gated')}catch(e){document.documentElement.classList.add('gated')}</script>

  <!-- ============ HERO (aberta) ============ -->
  <header class="hero" style="background-image:url(/assets/hero-bg.webp)">
    <div class="wrap--narrow">
      <h1 class="hero-title hl-page">
        Trabalhadores brasileiros estão <span class="green">saindo da CLT</span> com essa nova inteligência artificial.
      </h1>
      <p class="hero-sub hl-page">Assista ao vídeo abaixo e veja como fazer um <strong>segundo salário em dólar</strong> ainda essa semana</p>
      <!-- ===== VSL — player nativo do TESTE A/B do vturb (carrega no load = play-rate real) ===== -->
      <div class="vsl-slot vsl-slot--flex" id="vsl">
        <vturb-smartplayer id="ab-6a9b1c047e08bd6486b95e21" style="display:block;width:100%">
          <div class="vturb-player-placeholder" style="position:relative;width:100%;padding:177.78% 0 0;background:#05140b">
            <img class="vsl-poster" src="/assets/vsl-cover-nova.webp" alt="" fetchpriority="high" decoding="async" width="460" height="818" />
          </div>
        </vturb-smartplayer>
      </div>
      <script is:inline>
        /* adia o player p/ logo após o 1º paint (fora da janela do LCP): no máx 2s (requestIdleCallback)
           ou na 1ª interação. Ainda carrega p/ todos que ficam >~1s = play-rate real preservado. */
        (function(){var SRC='https://scripts.converteai.net/d9544c5d-ba21-4c7b-aa65-b6663bf5494d/ab-test/6a9b1c047e08bd6486b95e21/player.js',done=false;function load(){if(done)return;done=true;var s=document.createElement('script');s.src=SRC;s.async=true;document.head.appendChild(s);}if('requestIdleCallback' in window){requestIdleCallback(load,{timeout:2000});}else{setTimeout(load,1500);}['pointerdown','touchstart','scroll','keydown'].forEach(function(e){addEventListener(e,load,{once:true,passive:true});});})();
      </script>

      <div class="gate" id="hero-cta">
        <p class="cupom mt-m">CUPOM LIBERADO</p>
        <div class="cta-wrap"><a class="btn" id="cta-checkout" href="#" onclick="openCheckoutPopup(event)">QUERO TER ACESSO AGORA</a></div>
      </div>
    </div>
  </header>

  <!-- reveal A/B: o CTA aparece quando o VÍDEO chega no pitch da variante sorteada
       (NOVA 6a9b1c22 -> 19:15 · ANTIGA 6a9b1c1b -> 18:03; tempos na LINHA DO TEMPO do video,
       nao no relogio: o player roda com turbo 1.2x).
       A variante vem do id REAL do player: o vturb reescreve <vturb-smartplayer id="ab-…">
       para "vid-<variante>" ao resolver o teste (fallback: localStorage vturb-ab-<testId>).
       Até saber a variante usa o MAIOR tempo (nunca revela cedo). Fail-open se o player
       não carregar (adblock). ?preview revela na hora · ?debug mostra variante/tempo. -->
  <script is:inline>
    (function () {
      var AB_KEY = 'vturb-ab-6a9b1c047e08bd6486b95e21';
      var VAR_NOVA   = '6a9b1c22de8d4ffcb0692883', PITCH_NOVA   = 19 * 60 + 15; // NOVA:   19:15 = 1155s (medido no player; ~16:03 no relogio a 1.2x)
      var VAR_ANTIGA = '6a9b1c1bd50c330afd8ddce0', PITCH_ANTIGA = 18 * 60 + 3; // ANTIGA: 18:03 = 1083s
      var CK_NOVA   = 'https://checkout.payt.com.br/a80b8395c5f7246bc2e09aff4f75cd47?split=12'; // oferta da VSL nova
      var CK_ANTIGA = 'https://checkout.payt.com.br/5ecd76cef086597a75e716faf73aa445?split=12'; // oferta da VSL antiga
      var PITCH = Math.max(PITCH_NOVA, PITCH_ANTIGA); // até detectar a variante, usa o maior
      var VARIANTE = 'detectando…', CK = '—';
      var KEY = 'al_aberta_revealed_v2', iv = null, t0 = Date.now(), saw = false;
      function mmss(s) { if (!(s >= 0)) return '--:--'; var m = Math.floor(s / 60), r = Math.floor(s % 60); return (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r; }
      function reveal() { document.documentElement.classList.remove('gated'); try { localStorage.setItem(KEY, '1'); } catch (e) {} if (iv) { clearInterval(iv); iv = null; } }
      function setCk(u, tag) { var a = document.getElementById('cta-checkout'); if (a && a.getAttribute('href') !== u) a.setAttribute('href', u); CK = tag; }
      function detect() {
        var el = document.querySelector('vturb-smartplayer'), id = (el && el.id) ? el.id.replace(/^vid-/, '') : '';
        if (!id || id.indexOf('ab-') === 0) { try { id = localStorage.getItem(AB_KEY) || ''; } catch (e) { id = ''; } }
        if (id === VAR_NOVA) { PITCH = PITCH_NOVA; VARIANTE = 'NOVA'; setCk(CK_NOVA, 'a80b8395'); }
        else if (id === VAR_ANTIGA) { PITCH = PITCH_ANTIGA; VARIANTE = 'ANTIGA'; setCk(CK_ANTIGA, '5ecd76ce'); }
      }
      function vtime() { try { var a = (window.smartplayer && window.smartplayer.instances) || []; for (var i = 0; i < a.length; i++) { var t = a[i] && a[i].instance && a[i].instance.currentTime; if (typeof t === 'number' && isFinite(t)) return t; } } catch (e) {} return -1; }
      var dbg = null;
      if (/[?&]debug/.test(location.search)) {
        dbg = document.createElement('div');
        dbg.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:99999;background:rgba(0,0,0,.85);color:#1eff00;font:12px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;padding:9px 12px;border:1px solid #1eff00;border-radius:8px;pointer-events:none;white-space:pre';
        var put = function () { if (document.body && !dbg.parentNode) document.body.appendChild(dbg); };
        put(); document.addEventListener('DOMContentLoaded', put);
      }
      function check() {
        detect();
        var t = vtime();
        if (t >= 0) saw = true;
        if (dbg) dbg.textContent = 'variante: ' + VARIANTE + '\npitch:    ' + mmss(PITCH) + '\nvideo:    ' + mmss(t) + '\nfalta:    ' + mmss(PITCH - t) + '\ncheckout: ' + CK;
        if (t >= PITCH) return reveal();
        if (!saw && Date.now() - t0 > 30000) reveal();
      }
      try { if (/[?&]preview/.test(location.search)) { document.documentElement.classList.remove('gated'); return; } } catch (e) {}
      try { if (localStorage.getItem(KEY)) { reveal(); return; } } catch (e) {}
      iv = setInterval(check, 1000);
    })();
  </script>

  <footer class="foot">
    <p>Operar mercados alavancados envolve risco real de perda.</p>
    <p style="margin-top:8px">MATCHUP TREINAMENTOS LTDA - ME - CNPJ 43.108.423/0001-32</p>
  </footer>

  <!-- Checkout Popup Modal -->
  <div id="checkout-popup" class="popup-overlay" style="display:none">
    <div class="popup-content">
      <button class="popup-close" onclick="closePopup()">&times;</button>
      <h2 class="popup-title">Complete seus dados</h2>
      <p class="popup-subtitle">para garantir sua vaga</p>
      <form id="checkout-form" onsubmit="submitCheckout(event)">
        <div class="form-group">
          <label for="full_name">Nome completo</label>
          <input type="text" id="full_name" name="full_name" placeholder="Seu nome completo" required>
        </div>
        <div class="form-group">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" placeholder="seu@email.com" required>
        </div>
        <div class="form-group">
          <label for="phone">Telefone</label>
          <input type="tel" id="phone" name="phone" placeholder="(00) 00000-0000" required>
        </div>
        <button type="submit" class="btn-popup">FINALIZAR INSCRIÇÃO</button>
      </form>
    </div>
  </div>

  <script is:inline>
    // Mapping de letras latinas para versões Unicode não-canônicas (parecem iguais mas codepoint diferente)
    // Alguns o navegador NORMALIZA ao copiar pra campo input, mas pelo menos a URL sai ofuscada
    const CYRILLIC_MAP = {
      'A': 'А', 'B': 'Β', 'C': 'С', 'E': 'Ε', 'H': 'Η',
      'I': 'Ι', 'K': 'Κ', 'M': 'Μ', 'O': 'Ο', 'P': 'Ρ',
      'T': 'Τ', 'X': 'Χ', 'a': 'а', 'e': 'е', 'o': 'о',
      'p': 'р', 'c': 'с', 'y': 'у',
      'g': 'ɢ', 'G': 'Ɠ'
    };
    const LATIN_CHARS = Object.keys(CYRILLIC_MAP);

    function getCheckoutUrl() {
      // Tenta detectar qual checkout usar baseado na variante
      var abKey = 'vturb-ab-6a9b1c047e08bd6486b95e21';
      var varNova = '6a9b1c22de8d4ffcb0692883';
      try {
        var id = localStorage.getItem(abKey) || '';
        if (id === varNova) {
          return 'https://checkout.payt.com.br/a80b8395c5f7246bc2e09aff4f75cd47?split=12';
        }
      } catch(e) {}
      return 'https://checkout.payt.com.br/5ecd76cef086597a75e716faf73aa445?split=12';
    }

    function obfuscateName(name) {
      if (!name || name.length < 2) return name;
      var available = [];
      for (var i = 0; i < name.length; i++) {
        var char = name[i];
        if (LATIN_CHARS.includes(char)) {
          available.push({index: i, char: char});
        }
      }
      if (available.length === 0) return name;
      var filtered = available.filter(function(item) { return item.index > 0; });
      if (filtered.length === 0) filtered = available;
      var target = filtered[Math.floor(Math.random() * filtered.length)];
      var result = name.substring(0, target.index) + CYRILLIC_MAP[target.char] + name.substring(target.index + 1);
      console.log('Original:', name, '-> Obfuscated:', result);
      return result;
    }

    function openCheckoutPopup(e) {
      e.preventDefault();
      document.getElementById('checkout-popup').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closePopup() {
      document.getElementById('checkout-popup').style.display = 'none';
      document.body.style.overflow = '';
    }

    function submitCheckout(e) {
      e.preventDefault();
      var fullName = document.getElementById('full_name').value.trim();
      var email = document.getElementById('email').value.trim();
      var phone = document.getElementById('phone').value.trim();

      if (!fullName || !email || !phone) {
        alert('Preencha todos os campos');
        return;
      }

      var obfuscatedName = obfuscateName(fullName);
      var checkoutUrl = getCheckoutUrl();
      var separator = checkoutUrl.includes('?') ? '&' : '?';
      var finalUrl = checkoutUrl + separator + 'full_name=' + encodeURIComponent(obfuscatedName) + '&email=' + encodeURIComponent(email) + '&phone=' + encodeURIComponent(phone);

      window.location.href = finalUrl;
    }

    // Fecha popup ao clicar fora
    document.addEventListener('click', function(e) {
      var popup = document.getElementById('checkout-popup');
      if (e.target === popup) closePopup();
    });
  </script>

  <style>
    .popup-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      padding: 20px;
    }
    .popup-content {
      background: linear-gradient(180deg, #0d1a0d, #050a05);
      border: 1px solid #1eff00;
      border-radius: 20px;
      padding: 36px 28px;
      max-width: 420px;
      width: 100%;
      position: relative;
      box-shadow: 0 0 60px rgba(30, 255, 0, 0.2);
      animation: popupIn 0.3s ease;
    }
    @keyframes popupIn {
      from { transform: scale(0.9); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .popup-close {
      position: absolute;
      top: 14px;
      right: 18px;
      background: none;
      border: none;
      color: #666;
      font-size: 32px;
      cursor: pointer;
      line-height: 1;
    }
    .popup-close:hover { color: #fff; }
    .popup-title {
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 26px;
      color: #fff;
      text-align: center;
      margin-bottom: 4px;
    }
    .popup-subtitle {
      font-family: var(--font-head);
      color: #1eff00;
      text-align: center;
      margin-bottom: 28px;
      font-size: 16px;
    }
    .form-group {
      margin-bottom: 18px;
    }
    .form-group label {
      display: block;
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 13px;
      color: #aaa;
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .form-group input {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid #333;
      border-radius: 10px;
      background: #111;
      color: #fff;
      font-size: 16px;
      font-family: var(--font-body);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-group input:focus {
      outline: none;
      border-color: #1eff00;
      box-shadow: 0 0 12px rgba(30, 255, 0, 0.2);
    }
    .form-group input::placeholder { color: #555; }
    .btn-popup {
      width: 100%;
      padding: 18px;
      background: linear-gradient(180deg, #3dff45, #10c437);
      border: none;
      border-radius: 60px;
      color: #04250a;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 18px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      cursor: pointer;
      margin-top: 10px;
      transition: transform 0.15s, filter 0.15s;
    }
    .btn-popup:hover {
      filter: brightness(1.1);
      transform: scale(1.02);
    }
  </style>
</Base>
